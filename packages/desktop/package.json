{
  "name": "@canvabase/desktop",
  "version": "0.1.0",
  "description": "CanvaBase Database Management Desktop Client",
  "author": "CanvaStack",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b tsconfig.json",
    "prepackage": "node -e \"if (process.platform === 'win32') try { require('child_process').execSync('taskkill /F /IM CanvaBase.exe', {stdio:'ignore'}); } catch {}\"",
    "package": "npm run prepackage && npm run build && npx electron-builder --dir -c.forceCodeSigning=false"
  },
  "dependencies": {
    "@canvabase/contracts": "*",
    "@canvabase/dialects": "*",
    "@canvabase/shared": "*",
    "@tanstack/react-virtual": "^3.14.9",
    "@xyflow/react": "^12.11.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.canvastack.canvabase",
    "productName": "CanvaBase",
    "electronVersion": "33.2.1",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "out/**/*"
    ],
    "afterPack": "./scripts/afterPack.cjs",
    "win": {
      "target": "dir",
      "icon": "src/renderer/src/assets/logo.png"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
